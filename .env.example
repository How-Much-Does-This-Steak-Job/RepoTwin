# RepoTwin Frontend Environment Variables

# Backend API URL
# Default: http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Use mock data instead of backend
# Set to "true" to always use local sample data
# Set to "false" to connect to backend (with automatic fallback)
# Default: false
NEXT_PUBLIC_USE_MOCK=false
