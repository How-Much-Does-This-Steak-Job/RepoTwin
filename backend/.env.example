# RepoTwin Backend Environment Variables

# Application
APP_NAME=RepoTwin
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/repotwin
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# IBM watsonx.ai (Optional - for AI-enhanced analysis)
# If not configured, the system will use heuristic analysis only
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm-granite-13b-chat-v2
WATSONX_MAX_TOKENS=4096
WATSONX_TEMPERATURE=0.1
WATSONX_TOP_P=0.9
WATSONX_RATE_LIMIT_PER_MINUTE=100

# Git
GIT_CLONE_TIMEOUT=300
GIT_MAX_REPO_SIZE_MB=500
GIT_STORAGE_PATH=/tmp/repotwin/repos

# Analysis
ANALYSIS_MAX_CONTEXT_SIZE=100000
ANALYSIS_TIMEOUT_SECONDS=300
MAX_FILES_PER_ANALYSIS=50

# Caching
CACHE_TTL_REPOSITORY=3600
CACHE_TTL_DEPENDENCY_GRAPH=3600
CACHE_TTL_ANALYSIS_RESULTS=86400

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS_STR=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100