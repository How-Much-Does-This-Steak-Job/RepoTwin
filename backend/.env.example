# RepoTwin Backend Environment Configuration

# Application
APP_NAME=RepoTwin
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL - optional for MVP)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/repotwin
DATABASE_POOL_SIZE=20

# Redis (Required)
# Local development:
REDIS_URL=redis://localhost:6379/0
# Docker Compose:
# REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# IBM watsonx.ai (Optional - only for live mode)
# WATSONX_API_KEY=your-api-key-here
# WATSONX_PROJECT_ID=your-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm-granite-13b-chat-v2

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Analysis Settings
ANALYSIS_TIMEOUT_SECONDS=300
MAX_FILES_PER_ANALYSIS=50

# Caching TTLs (in seconds)
CACHE_TTL_REPOSITORY=3600
CACHE_TTL_ANALYSIS_RESULTS=86400
