{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "FRONTEND_URL": "https://repotwin.vercel.app",
    "BACKEND_URL": "https://repotwin.vercel.app/api"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "/api"
    }
  }
}